{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1-1",
  "version": "0.1.0-alpha.4",
  "identifier": "com.drift.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "1-1",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Remote desktop client",
    "longDescription": "1-1 is a remote desktop client for Windows, macOS, and Linux.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false,
    "useLocalToolsDir": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/norandom/1-1/releases/download/preview-channel/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MEIzMjY3MzJBMDE1REUKUldUZUZhQXlaeklMR0U3dUNaWC9zSk81d1JjcTY1bjJFekxVNWVlNURUVC9IVXlQTmRKbU5OWGsK"
    }
  }
}
